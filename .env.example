# Optional. Needed only when Gemini is selected and no key is entered in Settings.
# To use a local Ollama model instead, see OLLAMA.md; no Gemini key is needed.
# This is a placeholder key. Replace it with a real key only for Gemini requests.
# If left as the placeholder, it will not authenticate Gemini API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY
